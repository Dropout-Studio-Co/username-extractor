			"$value": { "colorSpace": "oklch", "components": [0, 0, 0], "alpha": 0.5 }
		},
		"ink1000Alpha10": {
			"$value": { "colorSpace": "oklch", "components": [0, 0, 0], "alpha": 0.1 }
		},
		"ink1000Alpha08": {
			"$value": { "colorSpace": "oklch", "components": [0, 0, 0], "alpha": 0.08 }
		},
		"ink1000Alpha06": {
			"$value": { "colorSpace": "oklch", "components": [0, 0, 0], "alpha": 0.06 }
		},
		"ink1000Alpha05": {
			"$value": { "colorSpace": "oklch", "components": [0, 0, 0], "alpha": 0.055 }
		},
		"ink1000Alpha0": { "$value": { "colorSpace": "oklch", "components": [0, 0, 0], "alpha": 0 } },
		"ink500Alpha40": {
			"$value": { "colorSpace": "oklch", "components": [0.556, 0, 0], "alpha": 0.4 }
		}
	},
	"typeScale": {
		"$type": "dimension",
		"micro": { "$value": { "value": 0.625, "unit": "rem" } },
		"caption": { "$value": { "value": 0.75, "unit": "rem" } },
		"label": { "$value": { "value": 0.875, "unit": "rem" } },
		"body": { "$value": { "value": 1, "unit": "rem" } },
		"bodyLg": { "$value": { "value": 1.0625, "unit": "rem" } },
		"button": { "$value": { "value": 0.875, "unit": "rem" } },
		"lead": { "$value": { "value": 1.125, "unit": "rem" } },
		"subtitle": {
			"$value": { "value": 1.5, "unit": "rem" },
			"$extensions": {
				"org.dropout.fluid": {
					"min": { "value": 1.25, "unit": "rem" },
					"preferred": "calc(1.125rem + 0.625vw)",
					"max": { "value": 1.5, "unit": "rem" }
				}
			}
		},
		"titleSm": {
			"$value": { "value": 1.875, "unit": "rem" },
			"$extensions": {
				"org.dropout.fluid": {
					"min": { "value": 1.375, "unit": "rem" },
					"preferred": "calc(1.125rem + 1vw)",
					"max": { "value": 1.875, "unit": "rem" }
				}
			}
		},
		"title": {
			"$value": { "value": 2.25, "unit": "rem" },
			"$extensions": {
				"org.dropout.fluid": {
					"min": { "value": 1.75, "unit": "rem" },
					"preferred": "calc(1.5rem + 1vw)",
					"max": { "value": 2.25, "unit": "rem" }
				}
			}
		},
		"titleLg": {
			"$value": { "value": 3, "unit": "rem" },
			"$extensions": {
				"org.dropout.fluid": {
					"min": { "value": 2, "unit": "rem" },
					"preferred": "calc(1.625rem + 1.75vw)",
					"max": { "value": 3, "unit": "rem" }
				}
			}
		},
		"display": {
			"$value": { "value": 3.75, "unit": "rem" },
			"$extensions": {
				"org.dropout.fluid": {
					"min": { "value": 2.5, "unit": "rem" },
					"preferred": "calc(2rem + 2.5vw)",
					"max": { "value": 3.75, "unit": "rem" }
				}
			}
		},
		"hero": {
			"$value": { "value": 6, "unit": "rem" },
			"$extensions": {
				"org.dropout.fluid": {
					"min": { "value": 3, "unit": "rem" },
					"preferred": "calc(2.75rem + 3.5vw)",
					"max": { "value": 6, "unit": "rem" }
				}
			}
		}
	},
	"font": {
		"$type": "fontFamily",
		"sans": {
			"$value": [
				"-apple-system",
				"BlinkMacSystemFont",
				"Google Sans Flex",
				"system-ui",
				"Segoe UI",
				"Roboto",
				"Helvetica",
