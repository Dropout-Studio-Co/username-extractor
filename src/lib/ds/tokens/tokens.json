		"danger": { "$value": { "colorSpace": "oklch", "components": [0.577, 0.245, 27.325] } },
		"dangerLight": { "$value": { "colorSpace": "oklch", "components": [0.5, 0.2, 27.325] } },
		"dangerDark": { "$value": { "colorSpace": "oklch", "components": [0.704, 0.191, 22.216] } },
		"statusConnected": { "$value": { "colorSpace": "oklch", "components": [0.696, 0.149, 162.5] } },
		"ink0Alpha72": { "$value": { "colorSpace": "oklch", "components": [1, 0, 0], "alpha": 0.72 } },
		"ink0Alpha20": { "$value": { "colorSpace": "oklch", "components": [1, 0, 0], "alpha": 0.2 } },
		"ink0Alpha10": { "$value": { "colorSpace": "oklch", "components": [1, 0, 0], "alpha": 0.1 } },
		"ink0Alpha05": { "$value": { "colorSpace": "oklch", "components": [1, 0, 0], "alpha": 0.05 } },
