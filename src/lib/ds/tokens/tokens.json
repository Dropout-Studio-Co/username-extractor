{
	"$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
	"$description": "Dropout Design System tokens. DTCG 2025.10 is the machine-readable source of truth.",
	"color": {
		"$type": "color",
		"ink": {
			"0": { "$value": { "colorSpace": "oklch", "components": [1, 0, 0] } },
			"50": { "$value": { "colorSpace": "oklch", "components": [0.985, 0, 0] } },
			"100": { "$value": { "colorSpace": "oklch", "components": [0.97, 0, 0] } },
			"200": { "$value": { "colorSpace": "oklch", "components": [0.922, 0, 0] } },
			"300": { "$value": { "colorSpace": "oklch", "components": [0.708, 0, 0] } },
			"400": { "$value": { "colorSpace": "oklch", "components": [0.63, 0, 0] } },
			"500": { "$value": { "colorSpace": "oklch", "components": [0.556, 0, 0] } },
			"600": { "$value": { "colorSpace": "oklch", "components": [0.371, 0, 0] } },
			"700": { "$value": { "colorSpace": "oklch", "components": [0.325, 0, 0] } },
			"750": { "$value": { "colorSpace": "oklch", "components": [0.275, 0, 0] } },
