{
    "name": "username-extractor",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite dev --open",
        "benchmark": "bun scripts/benchmark.ts",
        "build": "vite build && node scripts/wrap-worker.mjs",
        "preview": "bun run build && wrangler dev",
        "deploy": "bun run build && wrangler deploy",
        "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
        "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
        "format": "prettier --write .",
        "lint": "prettier --check . && eslint .",
        "sync-ds": "rsync -a --delete ../../dropout-design-system/src/lib/ ./src/lib/ds/",
        "test": "vitest run",
        "test:watch": "vitest",
        "cf-typegen": "wrangler types",
        "db:generate": "drizzle-kit generate",
        "db:push": "drizzle-kit push",
        "db:studio": "drizzle-kit studio",
        "db:check": "drizzle-kit check",
        "db:migrate": "wrangler d1 migrations apply username-extractor --remote",
        "db:migrate:local": "wrangler d1 migrations apply username-extractor --local",
        "db:migrate:list": "wrangler d1 migrations list username-extractor --local",
        "seed": "wrangler d1 execute username-extractor --local --file ./seed/seed.sql"
    },
    "devDependencies": {
        "@cloudflare/workers-types": "^5.20261030.1",
        "@eslint/compat": "^2.1.1",
        "@eslint/js": "^10.0.1",
        "@sveltejs/adapter-cloudflare": "^7.2.9",
        "@sveltejs/enhanced-img": "^0.11.0",
        "@sveltejs/kit": "^2.70.2",
        "@sveltejs/vite-plugin-svelte": "^7.3.1",
        "@tailwindcss/vite": "^4.3.3",
        "@types/node": "^26.6.6",
        "drizzle-kit": "0.31.11",
        "eslint": "^10.13.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-svelte": "^3.23.1",
        "globals": "^17.13.0",
        "prettier": "^3.9.10",
        "prettier-plugin-svelte": "^4.1.1",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "svelte": "5.57.3",
        "svelte-check": "^4.7.7",
        "tailwindcss": "^4.3.3",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.72.1",
        "vite": "^8.3.5",
        "vite-plugin-devtools-json": "^1.1.2",
        "vitest": "^4.1.10",
        "wrangler": "^4.156.0"
    },
    "dependencies": {
        "@better-auth/passkey": "1.7.14",
        "@lucide/svelte": "^1.65.0",
        "@notionhq/client": "^5.30.0",
        "@unpic/svelte": "^1.0.1",
        "better-auth": "^1.7.14",
        "bits-ui": "^2.20.2",
        "clsx": "^2.1.1",
        "drizzle-orm": "^0.45.4",
        "formsnap": "^2.1.0",
        "mode-watcher": "^1.1.0",
        "svelte-sonner": "^1.2.2",
        "sveltekit-superforms": "^2.30.2",
        "tailwind-merge": "^3.7.0",
        "tailwind-variants": "^3.3.1",
        "tw-animate-css": "^1.4.0",
        "vaul-svelte": "^0.3.2",
        "zod": "^4.6.7"
    }
}
